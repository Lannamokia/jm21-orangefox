diff --git a/etc/init.rc b/etc/init.rc
index 5c13ef74..61f10edc 100644
--- a/etc/init.rc
+++ b/etc/init.rc
@@ -105,6 +105,18 @@ service adbd /system/bin/adbd --root_seclabel=u:r:su:s0 --device_banner=recovery
     socket adbd stream 660 system system
     seclabel u:r:adbd:s0
 
+# The device is Virtual A/B capable (its fstab carries checkpoint=fs and
+# metadata_encryption, and boot leaves *_cow dm devices behind), but nothing
+# publishes that fact into recovery, so update_engine reads
+# ro.virtual_ab.enabled as false. That sends it down the "dynamic partitions
+# without VAB" path, where allocatable super space is halved and a full OTA
+# payload -- whose groups add up to the whole super -- is rejected with
+# CheckSuperPartitionAllocatableSpace() before a single byte is written.
+# The recovery branch of GetSpaceLimit() instead allows the full super.
+on early-init
+    setprop ro.virtual_ab.enabled true
+    setprop ro.virtual_ab.retrofit false
+
 # Always start adbd on userdebug and eng builds
 on property:ro.debuggable=1
     #write /sys/class/android_usb/android0/enable 1
@@ -134,6 +146,10 @@ on fs && property:sys.usb.configfs=1
     write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}
     mkdir /config/usb_gadget/g1/functions/ffs.adb
     mkdir /config/usb_gadget/g1/functions/ffs.fastboot
+    mkdir /config/usb_gadget/g1/functions/ffs.mtp
+    mkdir /config/usb_gadget/g1/os_desc 0775 shell shell
+    write /config/usb_gadget/g1/os_desc/b_vendor_code 0x1
+    write /config/usb_gadget/g1/os_desc/qw_sign "MSFT100"
     mkdir /config/usb_gadget/g1/configs/b.1 0777 shell shell
     mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
 
@@ -151,6 +167,23 @@ on fs
     mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
     mkdir /dev/usb-ffs/fastboot 0770 system system
     mount functionfs fastboot /dev/usb-ffs/fastboot rmode=0770,fmode=0660,uid=1000,gid=1000
+    mkdir /dev/usb-ffs/mtp 0770 shell shell
+    mount functionfs mtp /dev/usb-ffs/mtp rmode=0770,fmode=0660,uid=1000,gid=1000
+
+# update_engine -- the payload.bin path that flashes full A/B OTAs -- refuses to
+# run without a usable IBootControl, and the boot HAL's own .rc marks the service
+# 'disabled', so nothing starts it. Without it recovery can read the package but
+# cannot resolve the slot to write, and fails before touching a partition.
+on fs
+    start boot-hal-1-2
+
+service mount-external-sd /system/bin/sh /system/bin/mount-external-sd.sh
+    oneshot
+    user root
+    seclabel u:r:recovery:s0
+
+on fs
+    start mount-external-sd
 
 on property:sys.usb.config=adb
     start adbd
@@ -158,6 +191,9 @@ on property:sys.usb.config=adb
 on property:sys.usb.config=fastboot
     start fastbootd
 
+on property:sys.usb.config=mtp,adb
+    start adbd
+
 on property:sys.usb.config=none && property:sys.usb.configfs=0
     stop adbd
     stop fastbootd
@@ -189,6 +225,7 @@ on property:sys.usb.config=none && property:sys.usb.configfs=1
     stop fastbootd
     setprop sys.usb.ffs.ready 0
     rm /config/usb_gadget/g1/configs/b.1/f1
+    rm /config/usb_gadget/g1/configs/b.1/f2
     setprop sys.usb.state ${sys.usb.config}
 
 on property:sys.usb.config=sideload && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1
@@ -211,3 +248,23 @@ on property:sys.usb.config=fastboot && property:sys.usb.ffs.ready=1 && property:
     symlink /config/usb_gadget/g1/functions/ffs.fastboot /config/usb_gadget/g1/configs/b.1/f1
     write /config/usb_gadget/g1/UDC ${sys.usb.controller}
     setprop sys.usb.state ${sys.usb.config}
+
+on property:sys.usb.config=mtp && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1
+    write /config/usb_gadget/g1/idProduct 0x4EE1
+    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp"
+    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
+    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
+    setprop sys.usb.state ${sys.usb.config}
+
+on property:sys.usb.config=mtp,adb && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1
+    write /config/usb_gadget/g1/idProduct 0x4EE2
+    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
+    # Interface order matters on Windows: it matches interfaces for PID 0x4EE2 by
+    # number, and every android_winusb.inf variant (Google, OPLUS, vivo) claims MI_01
+    # for adb. Linking MTP first (f1 -> MI_00, class 06/01/01) is what AOSP does and
+    # the only order where Windows binds its built-in MTP driver to the MTP interface
+    # instead of handing it to the Android ADB/bootloader driver.
+    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
+    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
+    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
+    setprop sys.usb.state ${sys.usb.config}
diff --git a/gui/blanktimer.cpp b/gui/blanktimer.cpp
index 1c946ea7..31360e69 100755
--- a/gui/blanktimer.cpp
+++ b/gui/blanktimer.cpp
@@ -20,6 +20,8 @@
 */
 
 #include <string>
+#include <fstream>
+#include <cstdlib>
 #include <pthread.h>
 #include <sys/time.h>
 #include <time.h>
@@ -89,6 +91,22 @@ string blanktimer::getBrightness(void) {
 		DataManager::GetValue("tw_brightness", result);
 		if (result.empty())
 			result = "255";
+		// Clamp against the panel's real max_brightness. The OrangeFox theme
+		// recomputes tw_brightness as tw_brightness_max * pct / 100 and that can
+		// land out of range; writing it to sysfs fails and the unblank path would
+		// otherwise leave the display dark until reboot.
+		string brightness_file = DataManager::GetStrValue("tw_brightness_file");
+		size_t slash = brightness_file.rfind('/');
+		if (slash != string::npos) {
+			string max_file = brightness_file.substr(0, slash + 1) + "max_brightness";
+			ifstream max_stream(max_file.c_str());
+			int maxv = 0;
+			if (max_stream >> maxv && maxv > 0) {
+				int v = atoi(result.c_str());
+				if (v <= 0 || v > maxv)
+					result = maxv;
+			}
+		}
 	}
 	return result;
 }
