+	      brightness_value.find_first_not_of("0123456789") == std::string::npos;
+	  std::ifstream max_stream((brightness_file.substr(0, slash + 1) + "max_brightness").c_str());
+	  int maxv = 0;
+	  if (max_stream >> maxv && maxv > 0)
+	    {
+	      long v = numeric ? strtol(brightness_value.c_str(), nullptr, 10) : -1;
+	      if (v < 0 || v > maxv)
+		{
+		  std::ostringstream fixed;
+		  fixed << maxv;
+		  brightness_value = fixed.str();
+		}
